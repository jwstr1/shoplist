# Supabase
# Get these from your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anthropic (Claude) - for receipt parsing
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# App URL (needed for auth redirects)
# In development: http://localhost:3000
# In production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Woolworths API for store locator
# The stores API works without auth for basic lookups
WOOLWORTHS_API_BASE=https://www.woolworths.com.au/apis/ui/stores/

# Optional: Sentry for error tracking
# SENTRY_DSN=https://...

# Supabase Edge Function secrets (set in Supabase Dashboard → Edge Functions → Secrets)
# SUPABASE_URL=same as NEXT_PUBLIC_SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY=same as above
# AGPD_GITHUB_RAW=https://raw.githubusercontent.com/troykelly/costs-this-much/main/data/
